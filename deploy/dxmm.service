[Unit]
Description=dxmm.pt static site
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/dxmm/Work/dxmm
Environment=HOST=127.0.0.1
Environment=PORT=8765
Environment=LIVE_RELOAD=0
ExecStart=/home/dxmm/.local/share/mise/shims/node serve.mjs
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
